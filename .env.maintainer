# DON'T CHANGE THESE VARIABLES
# This file is updated by the maintaining team when new contracts are deployed, ips change, new testnets are released, etc


# Only used in `make node`
# Comma separated enode URLs for P2P discovery bootstrap.
# Preset with the Sigil enode URL.  No need to change
# For maintainer: this can be found with `docker logs sigil-node-op-geth-1 2>&1 | grep "enode"`.  Make sure to change the ip at the end to be the publically reachable one
GETH_BOOTNODES=enode://4e9bb3fade8845b9b390dd09bdeb3ee4938ae8c24cd444e796c51a6e90f4dadce51e7ca131bfbc84b6915d387ba8e9402f1e596a3a603a3aeb3a460ea2106dcd@162.243.185.44:30303


# Only used in `make node`
# Comma-separated multiaddr-format(an unsigned address, containing: IP, TCP port,
# PeerID) peer list. Static connections to make and maintain, these peers will be
# regarded as trusted. Addresses of the local peer are ignored.
# Duplicate/Alternative addresses for the same peer all apply, but only a single
# connection per peer is maintained.
# Preset with the Sigil Sequencer multiaddr.  No need to change
# For maintainer: switch out the p2p id at the end of this with the `peerID` string outputted from `docker logs sigil-node-op-node-1 2>&1 | grep "started p2p host"`
SEQUENCER_MULTIADDR=/ip4/162.243.185.44/tcp/9222/p2p/16Uiu2HAm1T53qSLRStrfXbbtGDa43tLw1XhUAsyJohcrVYAa21Ke

# Only used in `make node`
# Address of the sigil sequencer.  eth_sendRawTransaction will be routed to this sequencer
# Preset with the Sigil sequencer geth URL.  No need to change
# For maintainer: this is the publically reachable address of our sequencer's op-geth http process
SIGIL_SEQUENCER=http://162.243.185.44:8545

### op-stack, used in all
# Sepolia chain id
L1_CHAIN_ID=11155111
# Sigil chain id
L2_CHAIN_ID=51611
L1_BLOCK_TIME=12
L2_BLOCK_TIME=4

### op-succinct-validity, only used in `make exit`
# Contract address of the op-succinct L2 Output Oracle contract
L2OO_ADDRESS=0x28146445b816D4839f9b30B438c190bd89A4d6E9
# Contract address of the op-succinct dispute game factory
DGF_ADDRESS=0xc9b66033178E3b935f41C24846cd370a7e843822

### magister, Only used in `make exit`
# When a new Contemplant template is pushed to Vast.ai make sure to copy the new template hash from the Vast UI and add it here
VAST_TEMPLATE_HASH=1878058a3fab0d314a768287dc41c456
